{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "decorations": false,
        "height": 680,
        "label": "main",
        "minHeight": 480,
        "minWidth": 320,
        "resizable": true,
        "skipTaskbar": false,
        "title": "GENESIS",
        "transparent": true,
        "width": 480
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/llama-server-vulkan.exe",
      "resources/llama-server-cpu.exe",
      "resources/python/",
      "resources/brain/",
      "resources/chromium/"
    ]
  },
  "identifier": "com.genesis.final",
  "productName": "GENESIS Final",
  "version": "0.1.0",
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/369369yz-collab/genesis-windows/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNEQ3RUI5Rjk3Nzg5QkQKUldTOWlYZjV1WDVOa0Vzdm1yL0VTd3lOOFlVUHIxQmE0dG51RW8vazd4L3Y1WHp6UjFNUmJid2gK"
    }
  }
}